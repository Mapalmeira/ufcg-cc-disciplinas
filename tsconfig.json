{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": ["node_modules"]
}
